# Variáveis de ambiente do Lartiê. Copie para .env e preencha. Nunca coloque o .env no git.
# Nesta etapa (0), o app e os testes rodam só com os emuladores do Firebase (projeto demo-lartie)
# e não precisam de nenhuma variável. As abaixo entram com a API da VPS e a web do convidado.

# Projeto Firebase do ambiente (lartie-dev ou lartie)
FIREBASE_PROJECT_ID=

# Caminho da conta de serviço do Firebase Admin na VPS (fora do repositório), como no Newzi
GOOGLE_APPLICATION_CREDENTIALS=/etc/lartie/firebase-admin.json

# E-mail transacional (Resend)
RESEND_API_KEY=

# Endereço público da web do convidado (domínio a comprar, P13)
URL_PUBLICA=https://lartie.app

# Segredo dos links de 10 minutos para abrir arquivos do casal no navegador (contratos do T17).
# Gere com: openssl rand -hex 32
ARQUIVOS_SEGREDO=
