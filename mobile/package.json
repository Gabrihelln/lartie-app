{
  "name": "@lartie/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "sh scripts/adb-reverse.sh && react-native run-android --mode ${LARTIE_AMBIENTE:-demo}Debug --appId com.lartie.app --extra-params -PreactNativeArchitectures=arm64-v8a",
    "ios": "sh scripts/ambiente.sh ${LARTIE_AMBIENTE:-demo} && react-native run-ios --scheme Lartie",
    "start": "react-native start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "pods": "cd ios && pod install",
    "ambiente": "sh scripts/ambiente.sh",
    "android:reverse": "sh scripts/adb-reverse.sh"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@lartie/modelo": "file:../packages/modelo",
    "@lartie/regras": "file:../packages/regras",
    "@lartie/tokens": "file:../packages/tokens",
    "@material-symbols/svg-400": "0.48.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "^9.2.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/app-check": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-firebase/remote-config": "26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "7.19.1",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-device-info": "15.0.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.4"
