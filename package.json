{
  "name": "lartie",
  "private": true,
  "version": "0.0.0",
  "description": "Lartiê: casamento e casa nova",
  "workspaces": [
    "packages/*",
    "firebase",
    "api"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "tokens": "npm run gerar -w @lartie/tokens",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:regras-firestore": "npm run test:emulador -w @lartie/firebase",
    "emuladores": "npm run emuladores -w @lartie/firebase",
    "semear": "npm run semear -w @lartie/firebase",
    "api": "npm run dev:demo -w @lartie/api",
    "test:api": "npm run test:emulador -w @lartie/api"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
